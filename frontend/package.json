{
  "name": "servir-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "applications/*"
  ],
  "engines": {
    "node": "24.18.0"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @servir/web",
    "dev:bff": "npm run dev --workspace @servir/bff",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint:encoding && eslint . && stylelint \"applications/web/src/**/*.css\" \"applications/web/src/**/*.vue\"",
    "lint:encoding": "node scripts/check-text-encoding.mjs",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run format:check && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "4.20.6",
    "type-fest": "2.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.9"
  }
}
