API_BASE_URL=http://localhost:3000
API_TIMEOUT_MS=10000
HOST=0.0.0.0
PORT=3001

# Authentication signing (enable only with all values; never commit a real private JWK)
# AUTH_ISSUER=https://identity.servir.local
# AUTH_AUDIENCE=servir-api
# AUTH_KEY_ID=local-key
# AUTH_COOKIE_ENCRYPTION_KEY=<32 random bytes encoded as base64url>
# AUTH_PRIVATE_JWK={"kty":"RSA","kid":"local-key",...}
# AUTH_PRIVATE_JWK_FILE=/run/secrets/servir-auth-private-jwk
# AUTH_ACCESS_TOKEN_TTL_SECONDS=300
# AUTH_BOOTSTRAP_TTL_SECONDS=60
# AUTH_LOGIN_TRANSACTION_TTL_SECONDS=300

# Google OIDC (enable only with all values)
# GOOGLE_OIDC_CLIENT_ID=<google client id>
# GOOGLE_OIDC_CLIENT_SECRET=<google client secret>
# GOOGLE_OIDC_REDIRECT_URI=https://localhost/bff/auth/google/callback
