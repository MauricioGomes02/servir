# PostgreSQL outbox storage
DATABASE_URL=postgresql://servir_migrator:servir_migrator_local@localhost:5432/servir
LOG_LEVEL=info

# Kafka
KAFKA_BROKERS=localhost:29092
KAFKA_CLIENT_ID=servir-outbox-relay
KAFKA_RETRY_COUNT=5
KAFKA_PUBLISH_TIMEOUT_MS=10000

# Relay processing
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_DURATION_MS=60000
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_DELAY_MS=1000
OUTBOX_RETRY_MAX_DELAY_MS=300000
OUTBOX_RETRY_JITTER_RATIO=0.2

# OpenTelemetry
OTEL_SERVICE_NAME=servir-outbox-relay
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Enable after provisioning the local Collector with Terraform.
OTEL_SDK_DISABLED=false
