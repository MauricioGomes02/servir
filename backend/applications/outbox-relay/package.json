{
  "name": "@servir/outbox-relay",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "npm run test:unit",
    "test:unit": "tsc --noEmit && node ../../scripts/run-tests.mjs unit src",
    "test:integration": "tsc --noEmit && node ../../scripts/run-tests.mjs integration src",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@servir/integration-messaging": "1.0.0",
    "@servir/application-foundation": "1.0.0",
    "@servir/node-observability": "1.0.0",
    "kafkajs": "^2.2.4",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
