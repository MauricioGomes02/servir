{
  "name": "@servir/api",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "npm run test:unit",
    "test:unit": "tsc --noEmit && node ../../scripts/run-tests.mjs unit src",
    "test:integration": "tsc --noEmit && node ../../scripts/run-tests.mjs integration src",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.20.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@fastify/accepts": "^5.0.4",
    "@fastify/otel": "^0.20.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@servir/application-foundation": "1.0.0",
    "@servir/integration-messaging": "1.0.0",
    "@servir/node-observability": "1.0.0",
    "awilix": "^13.0.5",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "uuid": "^14.0.1"
  }
}
