# HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Persistence
PERSISTENCE_MODE=postgres
# Required by the API runtime.
DATABASE_URL=postgresql://servir_migrator:servir_migrator_local@localhost:5432/servir

# Authentication (enable only with all values; keep private keys in the BFF)
# AUTH_ISSUER=https://identity.servir.local
# AUTH_AUDIENCE=servir-api
# AUTH_JWKS={"keys":[{"kty":"RSA","kid":"local-key",...}]}
# AUTH_JWKS_FILE=/run/config/servir-auth-jwks

# OpenTelemetry
OTEL_SERVICE_NAME=servir-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Enable after provisioning the local Collector with Terraform.
OTEL_SDK_DISABLED=false
