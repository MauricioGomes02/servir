# HTTP
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Persistence
PERSISTENCE_MODE=memory
# Required only when PERSISTENCE_MODE=postgres.
DATABASE_URL=postgresql://servir_migrator:servir_migrator_local@localhost:5432/servir

# OpenTelemetry
OTEL_SERVICE_NAME=servir-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Enable after provisioning the local Collector with Terraform.
OTEL_SDK_DISABLED=false
