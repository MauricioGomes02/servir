# HTTP
HOST=0.0.0.0
PORT=3000

# Persistence
PERSISTENCE_MODE=memory
# Required only when PERSISTENCE_MODE=postgres.
DATABASE_URL=postgresql://servir_migrator:servir_migrator_local@localhost:5432/servir

# OpenTelemetry
OTEL_SERVICE_NAME=servir-api
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces

# Keep disabled locally until an OpenTelemetry Collector is available.
OTEL_SDK_DISABLED=true
